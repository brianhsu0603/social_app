# ---- Backend ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ---- Postgres ----
POSTGRES_USER=social
POSTGRES_PASSWORD=social
POSTGRES_DB=social
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://social:social@postgres:5432/social

# ---- MongoDB ----
MONGO_URL=mongodb://mongo:27017
MONGO_DB=social_chat

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CHAT_TOPIC=chat.messages
KAFKA_EVENTS_TOPIC=social.events
KAFKA_CONSUMER_GROUP=social-app

# ---- MinIO (S3-compatible) ----
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_SECURE=false

# ---- Search (Meilisearch) ----
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=masterKey

# ---- Push (FCM / APNs) ---- leave blank for dry-run logging
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
APNS_JWT=
APNS_BUNDLE_ID=

# ---- Tracing ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=social-backend

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
